{
	"name": "bluff-spoiler",
	"type": "module",
	"version": "0.0.1",
	"private": false,
	"description": "A dependency-free Web Component that hides sensitive inline content behind an animated particle field, with line-wrap support.",
	"author": {
		"name": "Condor Hero",
		"email": "love2xinwei@gmail.com"
	},
	"license": "MIT",
	"homepage": "https://condorheroblog.github.io/bluff-spoiler/",
	"repository": {
		"type": "git",
		"url": "https://github.com/condorheroblog/bluff-spoiler.git"
	},
	"bugs": {
		"url": "https://github.com/condorheroblog/bluff-spoiler/issues"
	},
	"keywords": [
		"web-components",
		"customelements",
		"spoiler",
		"particles",
		"canvas",
		"privacy",
		"sensitive-data",
		"blur",
		"ui"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"unpkg": "dist/index.iife.js",
	"jsdelivr": "dist/index.iife.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"prepare": "simple-git-hooks",
		"prepublishOnly": "npm run build",
		"build": "vite build",
		"test": "vitest",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp -r && pnpm -r publish --access public"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@eslint-react/eslint-plugin": "^5.18.7",
		"@microsoft/api-extractor": "^7.59.0",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "4.1.11",
		"bumpp": "^12.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.5.0",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.1",
		"vite": "8.2.2",
		"vitest": "^4.1.11"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs,cts,mts,json,md}": [
			"eslint --fix"
		]
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
